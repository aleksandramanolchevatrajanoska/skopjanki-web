# Postgres. On Vercel these two are added automatically by the Supabase integration.
# Locally both can point at the same database:
POSTGRES_PRISMA_URL="postgresql://postgres@localhost:5432/skopjanki"
POSTGRES_URL_NON_POOLING="postgresql://postgres@localhost:5432/skopjanki"
# Public URL of the site, used in emails and Stripe redirects
APP_URL="http://localhost:3000"
# Comma-separated emails that get the organiser (owner) role
OWNER_EMAILS="you@example.com"
# Email (Resend). Without a key, emails are printed to the console.
RESEND_API_KEY=""
EMAIL_FROM="Skopjanki <hello@your-domain.mk>"
# Stripe (fusion events + membership)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_MEMBERSHIP_PRICE_ID=""
STRIPE_CURRENCY="mkd"
# Protects /api/cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""
# "Ask Skopjanki" box on the home page (Claude API). Without a key the box is hidden.
ANTHROPIC_API_KEY=""
