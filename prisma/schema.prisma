generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Names set by the Vercel <-> Supabase integration.
  url       = env("POSTGRES_PRISMA_URL") // pooled (pgbouncer), used by the site
  directUrl = env("POSTGRES_URL_NON_POOLING") // direct, used for migrations
}

enum AccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventKind {
  WEEKLY // club weekly activity at a partner (weeks 1-3)
  SPECIAL // week 4: surprise, workshop, talk
  FUSION // monthly / bi-monthly fusion event, paid online
  MEMBER_PLAN // extra plan proposed by a member, needs approval
}

enum EventStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum PricingMode {
  SPLIT // total venue cost split among paying girls, members -discount
  PER_PERSON // fixed price per girl, members -discount
  ONLINE // fusion: fixed member / non-member price paid online via Stripe
}

enum ReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  WAITLIST
  OFFERED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                   String       @id @default(cuid())
  email                String       @unique
  name                 String
  phone                String?
  instagram            String?
  bio                  String?
  about                String? // "About me": longer, in her own words
  topics               String[] @default([]) // topics she cares about, from TOPICS + her own
  howHeard             String?
  levels               Json         @default("{}") // { "padel": "Advanced", ... }
  status               AccessStatus @default(PENDING)
  isOwner              Boolean      @default(false)
  memberUntil          DateTime?
  memberNumber         Int?         @unique
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  creditBalance        Int          @default(0) // MKD, from fusion cancellations
  locale               String       @default("en")
  showInCommunity      Boolean      @default(true)
  newsletterOptOut     Boolean      @default(false)
  createdAt            DateTime     @default(now())
  approvedAt           DateTime?

  sessions            Session[]
  reservations        Reservation[]
  captainApplications CaptainApplication[]
  debts               Debt[]               @relation("DebtUser")
  collectedDebts      Debt[]               @relation("DebtCollector")
  createdEvents       Event[]              @relation("EventCreator")
  captainOf           Event[]              @relation("EventCaptain")
  photos              Photo[]
  quote               Quote?
  address             Address?
}

model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  activity  String // e.g. "Tennis & padel"
  address   String?
  mapsUrl   String?
  instagram String?
  email     String? // receives the list of girls for each approved term
  phone     String?
  notes     String? // internal, organiser only
  offer     String? // what members get, e.g. "15% off court rental"
  code      String? // discount code, shown to members only
  active    Boolean  @default(true)
  example   Boolean  @default(false)
  createdAt DateTime @default(now())
  events    Event[]
}

model Event {
  id                String      @id @default(cuid())
  kind              EventKind
  status            EventStatus @default(APPROVED)
  title             String
  description       String?
  sport             String?
  level             String? // Beginner | Intermediate | Advanced, null = all levels
  vibe              String? // ACTIVE | SOCIAL | BOTH (Active, Social, Active + Social)
  tagline           String? // one line under the title, e.g. "Tennis & wine"
  agenda            Json? // [["11:00","Yoga"],["12:30","Brunch & mimosas"]]
  poster            EventPoster?
  example           Boolean     @default(false) // created by "Add example events"; removed in one click
  sourceUrl         String?     @unique // imported from Luma: the event's page, so it is never imported twice
  imageUrl          String? // cover image on the source site, when it could not be copied
  instagramUrl      String? // the event's Instagram post or reel ("See it on Instagram")
  videoUrls         String[]    @default([]) // Instagram reels, YouTube or TikTok links, shown in the carousel
  partnerId         String?
  partner           Partner?    @relation(fields: [partnerId], references: [id])
  place             String?
  startsAt          DateTime
  weekKey           String // ISO week of startsAt in Europe/Skopje, e.g. 2026-W48
  minSpots          Int         @default(1)
  maxSpots          Int
  pricingMode       PricingMode
  totalCost         Int? // SPLIT: venue cost in MKD
  priceNonMember    Int? // PER_PERSON / ONLINE
  priceMember       Int? // ONLINE (fusion member price). PER_PERSON uses discount
  memberDiscountPct Int         @default(20)
  memberEarlyHours  Int         @default(48)
  lockHours         Int         @default(48) // price locks & late-cancel window
  publishedAt       DateTime?
  lockedAt          DateTime?
  lockedPriceNonMember Int?
  lockedPriceMember    Int?
  minimumAlertSentAt   DateTime?
  captainAlertSentAt   DateTime?
  reminderSentAt       DateTime?
  attendanceClosedAt   DateTime?
  cancelReason      String?
  createdById       String
  createdBy         User        @relation("EventCreator", fields: [createdById], references: [id])
  captainId         String?
  captain           User?       @relation("EventCaptain", fields: [captainId], references: [id])
  createdAt         DateTime    @default(now())

  reservations        Reservation[]
  captainApplications CaptainApplication[]
  debts               Debt[]
  photos              Photo[]

  @@index([startsAt])
}

model Reservation {
  id              String            @id @default(cuid())
  eventId         String
  event           Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          ReservationStatus
  isMember        Boolean // member at the moment of booking (or lock)
  offeredUntil    DateTime?
  holdUntil       DateTime? // PENDING_PAYMENT expiry
  stripeSessionId String?           @unique
  stripePaymentIntentId String?
  replacedAt      DateTime? // late canceller whose seat was taken from the waitlist
  paidAmount      Int               @default(0) // online payment (fusion)
  creditUsed      Int               @default(0)
  attended        Boolean?
  lateCancel      Boolean           @default(false)
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([eventId, userId])
  @@index([eventId, status])
}

model CaptainApplication {
  id        String            @id @default(cuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  @@unique([eventId, userId])
}

model Debt {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("DebtUser", fields: [userId], references: [id], onDelete: Cascade)
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  amount        Int
  reason        String // LATE_CANCEL | NO_SHOW
  waivedAt      DateTime?
  paidAt        DateTime?
  collectedById String?
  collectedBy   User?     @relation("DebtCollector", fields: [collectedById], references: [id])
  createdAt     DateTime  @default(now())

  @@unique([userId, eventId])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  sent      Boolean
  createdAt DateTime @default(now())
}

/** Public partner application form (/partneri). Reviewed in /admin/partners. */
model PartnerApplication {
  id           String   @id @default(cuid())
  business     String
  kind         String
  address      String?
  person       String
  phone        String
  email        String
  instagram    String?
  website      String?
  sports       String[]
  priceRegular Int?
  priceGroup   Int?
  durationMin  Int?
  pricing      String? // "per court" | "per girl"
  perUnit      Int?
  units        Int?
  captainFree  String?
  offers       String[]
  discountPct  Int?
  gearPct      Int?
  otherOffer   String?
  hostWeekly   Boolean  @default(false)
  hostFusion   Boolean  @default(false)
  capacity     Int?
  days         String[]
  times        String?
  message      String?
  status       String   @default("NEW") // NEW | ACCEPTED | DECLINED
  partnerId    String?
  createdAt    DateTime @default(now())
}

/** "Moments with Skopjanki": photos added by girls who came to a past event. */
model Photo {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes // resized in the browser to max 1600 px, max 1.5 MB
  public    Boolean  @default(false) // organiser chooses which photos show on the public home page
  sourceId  String?  @unique // Instagram media id when imported, so a photo is never imported twice
  createdAt DateTime @default(now())

  @@index([eventId])
}

/** "What the girls say": one short quote per member. The organiser can hide it. */
model Quote {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** The monthly postcard / mail, one per month ("2026-11"). */
model Newsletter {
  month          String    @id
  headline       String
  intro          String?
  challengeTitle String?
  challengeText  String?
  tip            String?
  surprise       String? // unlocked with 3 stamps
  gift           String? // the small gift in the physical postcard
  sentAt         DateTime?
  updatedAt      DateTime  @updatedAt
}

/** Postal address for the physical postcard. Private: only the girl and the organiser see it. */
model Address {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  street    String
  zip       String
  city      String
  consentAt DateTime
  updatedAt DateTime @updatedAt
}

/** Poster image for an event (mostly fusion). Kept apart so event lists never load the bytes. */
model EventPoster {
  eventId   String   @id
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
}

/** Images the organiser sets for the site itself, e.g. "team" for the core team photo on the home card. */
model SiteImage {
  key       String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
}

/** Weekly letter to the girls: the week's events plus a thought the organiser writes. */
model WeeklyLetter {
  weekKey   String    @id // ISO week, e.g. 2026-W49
  title     String
  body      String
  sentAt    DateTime?
  sentCount Int       @default(0)
  updatedAt DateTime  @updatedAt
}

/** Small settings the organiser saves from Admin (e.g. the Instagram access token). Never shown to girls. */
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
