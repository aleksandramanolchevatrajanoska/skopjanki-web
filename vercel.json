{
  "buildCommand": "prisma migrate deploy && prisma generate && next build",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 7 * * *"
    }
  ],
  "regions": [
    "arn1"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "skopjanki-web.vercel.app"
        }
      ],
      "destination": "https://skopjanki.com/:path*",
      "permanent": false
    }
  ]
}
